<launch>
  <!-- 机器人选择 & 配置（ROS1 roslaunch 不支持 load_yaml()；改为静态映射 + 命令行覆盖） -->
  <arg name="robot_name" default="jaka1" />
  <arg name="robot_id" default="$(eval {'jaka1':1,'jaka2':2,'jaka3':3,'jaka4':4}.get(arg('robot_name'),1))" />
  <arg name="robot_ip" default="$(eval {'jaka1':'192.168.1.100','jaka2':'192.168.1.101','jaka3':'192.168.1.102','jaka4':'192.168.1.103'}.get(arg('robot_name'),'192.168.1.100'))" />

  <arg name="enable_jaka1" default="true" />
  <arg name="enable_jaka2" default="true" />
  <arg name="enable_jaka3" default="false" />
  <arg name="enable_jaka4" default="false" />

  <arg name="robot_ip_jaka1" default="192.168.1.100" />
  <arg name="robot_ip_jaka2" default="192.168.1.101" />
  <arg name="robot_ip_jaka3" default="192.168.1.102" />
  <arg name="robot_ip_jaka4" default="192.168.1.103" />

  <arg name="urdf_file" default="$(find jaka_close_contro)/urdf/jaka_zu3.urdf" />
  <arg name="csv_jaka1" default="$(find jaka_close_contro)/config/Ushape_sample12_points.csv" />
  <arg name="csv_jaka2" default="$(find jaka_close_contro)/config/magnetic_2_tcp_12points_from_current.csv" />
  <arg name="csv_jaka3" default="" />
  <arg name="csv_jaka4" default="" />
  <arg name="tcp_jaka1" default="magnetic_1" />
  <arg name="tcp_jaka2" default="magnetic_2" />
  <arg name="tcp_jaka3" default="magnetic_3" />
  <arg name="tcp_jaka4" default="magnetic_4" />

  <arg name="speed_scale" default="0.15" />
  <arg name="dwell_sec" default="2.0" />
  <arg name="angles_in_degrees" default="true" />
  <arg name="coord_mode" default="0" />
  <arg name="linear_move_service" default="/jaka_driver/linear_move" />
  <arg name="joint_state_topic" default="/joint_states" />
  <arg name="motion_done_timeout_sec" default="120.0" />
  <arg name="motion_stable_duration_sec" default="0.5" />
  <arg name="motion_joint_threshold_rad" default="0.002" />
  <arg name="round_trip" default="true" />
  <arg name="reverse_include_last" default="false" />
  <arg name="require_same_count" default="true" />
  <arg name="sync_by_idx" default="true" />

  <!-- 0. 机器人驱动 -->
  <group ns="jaka1" if="$(arg enable_jaka1)">
    <remap from="/joint_states" to="joint_states" />
    <include file="$(find jaka_close_contro)/launch/jaka_sdk_bringup.launch">
      <arg name="ip" value="$(arg robot_ip_jaka1)" />
      <arg name="urdf_file" value="$(arg urdf_file)" />
    </include>
  </group>

  <group ns="jaka2" if="$(arg enable_jaka2)">
    <remap from="/joint_states" to="joint_states" />
    <include file="$(find jaka_close_contro)/launch/jaka_sdk_bringup.launch">
      <arg name="ip" value="$(arg robot_ip_jaka2)" />
      <arg name="urdf_file" value="$(arg urdf_file)" />
    </include>
  </group>

  <group ns="jaka3" if="$(arg enable_jaka3)">
    <remap from="/joint_states" to="joint_states" />
    <include file="$(find jaka_close_contro)/launch/jaka_sdk_bringup.launch">
      <arg name="ip" value="$(arg robot_ip_jaka3)" />
      <arg name="urdf_file" value="$(arg urdf_file)" />
    </include>
  </group>

  <group ns="jaka4" if="$(arg enable_jaka4)">
    <remap from="/joint_states" to="joint_states" />
    <include file="$(find jaka_close_contro)/launch/jaka_sdk_bringup.launch">
      <arg name="ip" value="$(arg robot_ip_jaka4)" />
      <arg name="urdf_file" value="$(arg urdf_file)" />
    </include>
  </group>

  <!-- 1. CSV 路点执行 -->
  <node pkg="jaka_close_contro"
        type="jaka_csv_waypoint_player_node"
        name="jaka_csv_waypoint_player"
        output="screen">
    <param name="waypoint_csv" value="$(arg csv_jaka1)" />
    <param name="linear_move_service" value="$(arg linear_move_service)" />
    <param name="joint_state_topic" value="$(arg joint_state_topic)" />
    <param name="speed_scale" value="$(arg speed_scale)" />
    <param name="dwell_sec" value="$(arg dwell_sec)" />
    <param name="angles_in_degrees" value="$(arg angles_in_degrees)" />
    <param name="coord_mode" value="$(arg coord_mode)" />
    <param name="motion_done_timeout_sec" value="$(arg motion_done_timeout_sec)" />
    <param name="motion_stable_duration_sec" value="$(arg motion_stable_duration_sec)" />
    <param name="motion_joint_threshold_rad" value="$(arg motion_joint_threshold_rad)" />
    <param name="round_trip" value="$(arg round_trip)" />
    <param name="reverse_include_last" value="$(arg reverse_include_last)" />
    <param name="require_same_count" value="$(arg require_same_count)" />
    <param name="sync_by_idx" value="$(arg sync_by_idx)" />
    <param name="tcp_name" value="$(arg tcp_jaka1)" />
    <rosparam subst_value="true">
      arms:
        jaka1:
          enabled: $(arg enable_jaka1)
          tcp_name: $(arg tcp_jaka1)
          waypoint_csv: $(arg csv_jaka1)
          linear_move_service: /jaka1/jaka_driver/linear_move
          joint_state_topic: /jaka1/joint_states
        jaka2:
          enabled: $(arg enable_jaka2)
          tcp_name: $(arg tcp_jaka2)
          waypoint_csv: $(arg csv_jaka2)
          linear_move_service: /jaka2/jaka_driver/linear_move
          joint_state_topic: /jaka2/joint_states
        jaka3:
          enabled: $(arg enable_jaka3)
          tcp_name: $(arg tcp_jaka3)
          waypoint_csv: $(arg csv_jaka3)
          linear_move_service: /jaka3/jaka_driver/linear_move
          joint_state_topic: /jaka3/joint_states
        jaka4:
          enabled: $(arg enable_jaka4)
          tcp_name: $(arg tcp_jaka4)
          waypoint_csv: $(arg csv_jaka4)
          linear_move_service: /jaka4/jaka_driver/linear_move
          joint_state_topic: /jaka4/joint_states
    </rosparam>
  </node>
</launch>
